# InsPilot Cloud Baby — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# DingTalk enterprise internal app (https://open-dev.dingtalk.com)
# AppKey/AppSecret from 凭证与基础信息 — enables org-wide admin API access.
BUSINESS_ROBOT_DINGTALK_APP_KEY=你的AppKey
BUSINESS_ROBOT_DINGTALK_APP_SECRET=你的AppSecret

# OpenAI-compatible embedding service (optional; vector search degrades to keyword when unset)
BUSINESS_ROBOT_OPENAI_API_KEY=
BUSINESS_ROBOT_OPENAI_BASE_URL=
